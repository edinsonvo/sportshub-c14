{
  "uid": "sporthub-overview",
  "title": "SportHub — Visión operativa",
  "tags": ["sporthub", "backend"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Solicitudes HTTP por segundo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"sporthub-backend\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latencia HTTP (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"sporthub-backend\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Citas creadas (total)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(sporthub_appointments_created_total)",
          "legendFormat": "citas"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "JVM Heap usado (MB)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"sporthub-backend\"})/1024/1024",
          "legendFormat": "MB"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Estado de salud (UP=1)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "up{service=\"sporthub-backend\"}",
          "legendFormat": "{{__name__}}"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}